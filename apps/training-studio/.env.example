# Training Studio app — env template. Copy to `.env` and fill in.
#
# This app is a *.civitai.com SPOKE: it shares the hub's `.civitai.com` session cookie, so it needs NO login
# UI and NO OAuth-bridge endpoints. It only verifies the session and gates on "is logged in" — training is a
# normal user feature, so ANY authenticated Civitai user is allowed.

# --- Auth (spoke) ---
# The hub origin (token issuer). Used to verify the JWT `iss` and build the login redirect. Same var the
# main app and moderator app use.
AUTH_JWT_ISSUER=https://auth.civitai.com
# The hub's public keys, for LOCAL ES256 verification (no per-request hop for the signature check).
AUTH_JWKS_URI=https://auth.civitai.com/api/auth/jwks
# Shared service secret — lets the session client do INTERNAL-authed read-through against the hub.
AUTH_INTERNAL_TOKEN=
# Optional server-only override: route hub identity read-through to the in-cluster service URL instead of
# hairpinning out to AUTH_JWT_ISSUER's public edge. Standard @civitai/auth var; unset falls back to issuer.
#   e.g. http://civitai-auth.civitai-auth.svc.cluster.local:3000
AUTH_HUB_INTERNAL_URL=
# Shared key-hash salt. Required: this app mints the user's orchestrator token as an ApiKey row, hashed
# with generateSecretHash — must be the SAME NEXTAUTH_SECRET the main app / DB use, or the orchestrator
# can't validate the key.
NEXTAUTH_SECRET=

# Local dev against a LOCAL hub: point the two URLs at it, e.g.
#   AUTH_JWT_ISSUER=http://localhost:5173
#   AUTH_JWKS_URI=http://localhost:5173/api/auth/jwks
# (loopback hosts are auto-trusted by the hub in dev, so no seeding needed.)

# In `vite dev` the OAuth gate is bypassed by default so you can preview the UI without an auth hub.
# Set to 0 to exercise the real login (against a local auth hub). No effect in the built/prod server.
TRAINING_STUDIO_DEV_LOGIN=1

# --- Database (Kysely write via @civitai/db, src/lib/server/db.ts) ---
# Point at the same DB the main app / orchestrator use. This app's ONLY DB use is minting a short-lived
# `System` ApiKey per user for the orchestrator token (a write + a cleanup). `sslmode=no-verify` is forced
# in code for the cnpg pooler's self-signed cert, so the URL here doesn't need it.
DATABASE_URL=postgresql://user:pass@localhost:6543/civitai

# --- Redis (@civitai/redis) ---
# Cross-pod cache for the minted orchestrator token (get-or-mint), so a fresh key is minted ≈once/hour/user
# instead of per request. loadRedisEnv requires BOTH URLs; caching is fail-open, so if unset the app just
# mints per request. Same instances the main app reads.
REDIS_URL=redis://:redis@localhost:6379
REDIS_SYS_URL=redis://:redis@localhost:6380

# --- Orchestrator (@civitai/client) ---
# Generation/training backend. ENDPOINT + MODE mirror the main app's values (keep the trailing slash). This
# app calls it directly with a per-user token it mints itself (see DATABASE_URL above).
ORCHESTRATOR_ENDPOINT=https://orchestration.civitai.com/
ORCHESTRATOR_MODE=prod
# DEV-ONLY: a key minted into your LOCAL db can't be validated by a shared/prod orchestrator, so per-user
# minting 401s locally. To see YOUR OWN trainings, set MODE=dev and paste YOUR PERSONAL Civitai API key here
# (civitai.com → account → API keys; needs generation/full scope) — a real prod key scoped to you, so the
# orchestrator returns your actual workflows. Unused when MODE=prod (deployed, where minting works).
ORCHESTRATOR_ACCESS_TOKEN=
# Live per-epoch training trace (step progress + console logs shown on the run's detail page). OFF by
# default because sending this field before the orchestrator's trace feature is deployed could get the
# training submit rejected. Set to `events` (NDJSON: progress + logs) or `logs` (plain text) once the orch
# side is live. Leave unset / `none` otherwise.
TRAINING_TRACE_MODE=none

# --- Main app hand-off (deep link) ---
# Origin of the main civitai.com app. Publish / Generate on the run detail page navigate the browser to
# `<CIVITAI_URL>/models/train/...`, where the main app owns the publish wizard and the generator. Defaults
# to https://civitai.com; point at a local main app (e.g. http://localhost:3000) for local dev.
CIVITAI_URL=https://civitai.com
