    "fastify": "^5.12.6",
    "prom-client": "^14.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
