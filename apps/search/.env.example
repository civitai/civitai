# apps/search — search service in front of Qdrant. Dev-only file; prod reads real process.env.

# --- service ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Shared secret callers send as `Authorization: Bearer <token>`. Empty disables the gate (dev only);
# required in production.
SEARCH_TOKEN=

# --- Qdrant (read-only key) — REQUIRED ---
QDRANT_URL=
QDRANT_API_KEY=
# Collection or alias to read; defaults to the images_semantic alias. A key scoped to one collection
# cannot read through the alias, so name the collection.
QDRANT_IMAGE_COLLECTION=

# --- orchestrator, for query embeddings — REQUIRED ---
ORCHESTRATOR_ENDPOINT=
ORCHESTRATOR_ACCESS_TOKEN=
# `dev` targets the dev orchestrator; anything else is prod.
ORCHESTRATOR_MODE=

# --- Redis, for the query-embedding cache — optional, BOTH or neither ---
REDIS_URL=
REDIS_SYS_URL=
