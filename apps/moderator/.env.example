# Moderator app — env template. Copy to `.env` and fill in (real values live in the main app's repo-root .env).
#
# This app is a *.civitai.com SPOKE: it shares the hub's `.civitai.com` session cookie, so it needs NO login
# UI, NO OAuth-bridge endpoints, NO AUTH_COOKIE_DOMAIN, and NO TrustedSpokeDomain row (same registrable domain
# → shared cookie + the owned-domain redirect backstop). It only verifies the session and gates on isModerator.

# --- Auth (spoke) ---
# The hub origin (token issuer). Used to verify the JWT `iss` and to build the login redirect.
AUTH_JWT_ISSUER=https://auth.civitai.com
# The hub's public keys, for LOCAL ES256 verification (no per-request hop for the signature check).
AUTH_JWKS_URI=https://auth.civitai.com/api/auth/jwks
# Shared service secret — lets the session client do INTERNAL-authed read-through against the hub.
AUTH_INTERNAL_TOKEN=

# Local dev against a LOCAL hub: point the two URLs at it, e.g.
#   AUTH_JWT_ISSUER=http://localhost:5173
#   AUTH_JWKS_URI=http://localhost:5173/api/auth/jwks
# (loopback hosts are auto-trusted by the hub in dev, so no seeding needed.)

# Where authenticated NON-moderators get redirected (a 403 would be a dead end). Defaults to https://civitai.com.
# Also the base URL for the main-app Meilisearch callback (src/lib/server/search-index.ts).
# CIVITAI_APP_URL=https://civitai.com

# Base for content links shown to moderators (images, models, articles, profiles). Defaults to
# https://civitai.red, which renders every browsing level — a .com link can 404 on the very item being
# moderated. Deliberately does NOT fall back to CIVITAI_APP_URL: that is set to .com everywhere, so the
# fallback used to win and send every moderator link to .com. Set this to point somewhere else.
# CIVITAI_LINK_URL=https://civitai.red

# --- Main-app callbacks ---
# Shared secret for the main app's token-guarded internal endpoints (e.g. the Meilisearch re-index
# callback /api/internal/search-index-update). Must match the main app's WEBHOOK_TOKEN. Unset = sync no-ops.
# Also guards every endpoint wrapped in WebhookEndpoint ($lib/server/webhook-endpoint) — /api/mod/* and the
# XGuard agent API. Those answer 503 while it is unset. There is no user behind it: nothing it reaches may
# attribute a write, and revoking access means rotating it for every holder.
WEBHOOK_TOKEN=

# Moderator API key for /api/mod/retool/* (bulk comment + review actions). Those endpoints authenticate
# with a Bearer USER key and require the mod role — a different scheme from WEBHOOK_TOKEN, which they
# do not accept. Unset = those actions refuse instead of failing at the endpoint.
CIVITAI_MOD_API_KEY=

# Signals service, same value as the main app's SIGNALS_ENDPOINT. Session invalidation posts here so a
# mute, ban or force-logout reaches an ALREADY-CONNECTED client instead of waiting for its next refresh.
# Unauthenticated by design (the main app's client sends no header). Unset = the signal is skipped and
# revocation still applies on the user's next request.
SIGNALS_ENDPOINT=

# --- Database (Kysely read/write via @civitai/db/kysely, src/lib/server/db.ts) ---
# Point write at the primary and read at a replica (use the same URL for both if you have no replica).
# `sslmode=no-verify` is forced in code for the cnpg pooler's self-signed cert, so the URLs here don't need it.
DATABASE_URL=postgresql://user:pass@localhost:5432/civitai
# The MODERATOR database - moderation data that has never lived in Civitai's Postgres, plus the
# XGuard label lab tables. Separate instance, no foreign keys into the main database.
# Prod: internal-tools-db-rw.cnpg-database.svc.cluster.local:5432/internal_tools (via bastion)
# Local: docker compose -f xguard-lab/docker-compose.yml up -d
# Shared with the moderator app's own tables, so it deliberately carries NO search_path - setting
# one here would silently reorder name resolution for every other consumer.
MODERATOR_DATABASE_URL=postgres://xguard:xguard@localhost:5433/xguard_lab

DATABASE_REPLICA_URL=postgresql://user:pass@localhost:5432/civitai

# --- Retool database (single read-write Kysely client, src/lib/server/moderator-db.ts) ---
# Moderation data that has never lived in the main database: user notes, strikes, timed mutes, image
# help requests. Single client, no replica — this data is read-your-writes.
# Points at RETOOL's own Postgres so existing notes/strikes are usable while the tooling is built. When
# those tables migrate to the moderator database this collapses into MODERATOR_DATABASE_URL above.
# See docs/moderator-app/retool-exports/retool-db-tables.md.
RETOOL_DATABASE_URL=postgresql://user:pass@host:5432/retool

# --- Freshdesk (optional, User Lookup support panel) ---
# Without a key the support panel simply shows "no contact found" — it never blocks a lookup.
# The key is the Freshdesk API key, sent as the basic-auth username.
FRESHDESK_API_KEY=
FRESHDESK_DOMAIN=civitai.freshdesk.com

# --- Redis (@civitai/redis) ---
# Cache cluster + sysRedis. The spoke guard reads the `session:data2` cache (and can inject real-time revocation)
# instead of hitting the hub `/api/auth/identity` on every request. loadRedisEnv requires BOTH URLs.
REDIS_URL=redis://:redis@localhost:6379
REDIS_SYS_URL=redis://:redis@localhost:6380

# --- ClickHouse (@civitai/clickhouse) ---
# Required in prod, optional in dev. Backs moderator page-visit tracking (src/lib/server/page-visits.ts;
# table DDL in clickhouse/moderator_page_views.sql) + moderation metrics. Unset in dev = visits no-op.
CLICKHOUSE_HOST=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# --- Orchestrator (@civitai/client) ---
# Generation backend, used by the scanner-audit focused-review page to resolve scan content + raw
# workflow JSON (src/lib/server/orchestrator.ts). It's an external service (NOT the main civitai app),
# so the spoke calls it directly. Optional in dev (content just resolves as "unavailable" if unset).
# The XGuard lab's evaluation runs use the same two values for its prompt scans.
ORCHESTRATOR_ENDPOINT=
ORCHESTRATOR_MODE=dev
ORCHESTRATOR_ACCESS_TOKEN=

# --- XGuard label lab ---
# The AI rater's provider. Only the rating pass needs it.
OPENROUTER_API_KEY=

# --- CSAM (report storage bucket — DigitalOcean Spaces) ---
CSAM_UPLOAD_KEY=
CSAM_UPLOAD_SECRET=
CSAM_BUCKET_NAME=
CSAM_UPLOAD_REGION=auto
CSAM_UPLOAD_ENDPOINT=
# Local working dir for CSAM report assembly (empty = service default).
DIRNAME=

# --- NCMEC (CyberTipline) ---
# exttest.cybertip.org/ispws = sandbox; report.cybertip.org/ispws = production.
NCMEC_URL=https://exttest.cybertip.org/ispws
NCMEC_USERNAME=
NCMEC_PASSWORD=

# --- Media CDN (EdgeImage/EdgeVideo, $lib/media/edge-url.ts) ---
# Cloudflare-images delivery base; image keys (the Image row's `url` GUID) are appended to it.
# PUBLIC_ prefix exposes it to the browser via $env/dynamic/public. Mirrors the main app's
# NEXT_PUBLIC_IMAGE_LOCATION (prod value below; point at your dev cacher for local testing).
PUBLIC_IMAGE_LOCATION=https://image.civitai.com/xG1nkqKTMzGDvpLrqFT7WA
