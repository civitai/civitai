model eval_result {
  id        BigInt   @id @default(autoincrement())
  run_id    BigInt
  sample_id BigInt
  score     Float?   @db.Real
  predicted Boolean?
  expected  Boolean
  bucket    String?
  reason    String?
  error     String?
  eval_run  eval_run @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sample    sample   @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([run_id, sample_id])
  @@index([run_id, bucket], map: "eval_result_run_bucket_idx")
}

model eval_run {
  id           BigInt        @id @default(autoincrement())
  label        String
  policy_id    BigInt?
  policy_label String
  threshold    Float         @db.Real
  batch        String?
  status       String        @default("running")
  total        Int           @default(0)
  scored       Int           @default(0)
  errors       Int           @default(0)
  tp           Int           @default(0)
  fp           Int           @default(0)
  tn           Int           @default(0)
  fn           Int           @default(0)
  precision    Float?        @db.Real
  recall       Float?        @db.Real
  f1           Float?        @db.Real
  note         String?
  started_at   DateTime      @default(now()) @db.Timestamptz(6)
  finished_at  DateTime?     @db.Timestamptz(6)
  eval_result  eval_result[]
  label_policy label_policy? @relation(fields: [policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([label, started_at(sort: Desc)], map: "eval_run_label_idx")
}

model human_judgement {
  id                    BigInt             @id @default(autoincrement())
  sample_id             BigInt
  label                 String
  reviewed_judgement_id BigInt?
  agreed                Boolean?
  verdict               Boolean
  note                  String?
  reviewer_id           Int
  duration_ms           Int?
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  excluded_reason       String?
  label_def             label_def          @relation(fields: [label], references: [name], onUpdate: NoAction)
  machine_judgement     machine_judgement? @relation(fields: [reviewed_judgement_id], references: [id], onUpdate: NoAction)
  sample                sample             @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sample_id, label, reviewer_id])
  @@index([label, created_at(sort: Desc)], map: "human_judgement_label_idx")
}

model label_def {
