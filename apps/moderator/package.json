    "@civitai/db": "workspace:*",
    "@civitai/db-queries": "workspace:*",
    "@civitai/email": "workspace:*",
    "@civitai/db-schema": "workspace:*",
    "@civitai/mod-utils": "workspace:*",
    "@civitai/moderation": "workspace:*",
    "@civitai/notifications": "workspace:*",
