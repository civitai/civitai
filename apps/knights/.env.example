# Knights of New Order app — env template. Copy to `.env` and fill in. Placeholders only.
#
# A *.civitai.com SPOKE: it shares the hub's `.civitai.com` session cookie and has no login UI.

# --- Auth (spoke) ---
AUTH_JWT_ISSUER=https://auth.civitai.com
AUTH_JWKS_URI=https://auth.civitai.com/api/auth/jwks
AUTH_INTERNAL_TOKEN=
# Optional: route hub identity read-through to an internal service URL instead of the public issuer.
AUTH_HUB_INTERNAL_URL=

# Local dev against a LOCAL hub:
#   AUTH_JWT_ISSUER=http://localhost:5173
#   AUTH_JWKS_URI=http://localhost:5173/api/auth/jwks

# --- Access gate (@civitai/flipt, src/lib/server/access.ts) ---
# Moderators are always allowed; everyone else needs the `knights-of-new-order-app` flag on for them.
# Flags live in the `civitai-app` Flipt environment. Flag missing or Flipt down: moderators only.
FLIPT_URL=
FLIPT_FETCHER_SECRET=
# Dev-only: force the flag without touching shared Flipt state, e.g. `knights-of-new-order-app=on`.
# FLIPT_LOCAL_OVERRIDES=

# --- Database (the main Postgres; read via Kysely) ---
DATABASE_URL=postgres://user:password@localhost:5432/civitai

# --- Redis (system cluster; used only for session revocation checks) ---
REDIS_URL=redis://:password@localhost:6379
REDIS_SYS_URL=redis://:password@localhost:6380

# Main app base and shared secret used to write a settled rating back (/api/mod/image/kono-set-nsfw-level).
# WEBHOOK_TOKEN must equal the main app's; unset, a vote that would settle an image fails rather than skip.
CIVITAI_APP_URL=https://civitai.com
WEBHOOK_TOKEN=
# Image CDN base (https://image.civitai.com/<account hash>) for the images players are shown.
IMAGE_LOCATION=
# Token a scheduler must present to the /api/jobs/* endpoints. Unset: they refuse.
JOBS_TOKEN=
# Key for the sealed ids of feed items.
FEED_TOKEN_SECRET=
# Hidden check settings; unset values use the defaults in src/lib/server/hidden/config.ts.
KNIGHTS_HIDDEN_CHECK_RATE=
KNIGHTS_HIDDEN_CHECK_FAILURE_WINDOW_HOURS=
KNIGHTS_HIDDEN_CHECK_SEVERE_DISTANCE=
KNIGHTS_HIDDEN_CHECK_SETTLE_DELAY_MINUTES=

# Converting cleared gold to Yellow Buzz is OFF unless this is exactly `true`; gold keeps accruing and clearing either way.
# KNIGHTS_CONVERSION_ENABLED=true
# Buzz service base URL for converting cleared gold to Yellow Buzz. Unset: conversions stay pending.
BUZZ_ENDPOINT=
# Axiom logging; both must be set, neither alone does anything.
AXIOM_TOKEN=
AXIOM_ORG_ID=

# Notifications app base URL and shared secret.
NOTIFICATIONS_ENDPOINT=
NOTIFICATIONS_TOKEN=
