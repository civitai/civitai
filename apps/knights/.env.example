# Knights of New Order app — env template. Copy to `.env` and fill in. Placeholders only.
#
# A *.civitai.com SPOKE: it shares the hub's `.civitai.com` session cookie and has no login UI.

# --- Auth (spoke) ---
AUTH_JWT_ISSUER=https://auth.civitai.com
AUTH_JWKS_URI=https://auth.civitai.com/api/auth/jwks
AUTH_INTERNAL_TOKEN=
# Optional: route hub identity read-through to an internal service URL instead of the public issuer.
AUTH_HUB_INTERNAL_URL=

# Local dev against a LOCAL hub:
#   AUTH_JWT_ISSUER=http://localhost:5173
#   AUTH_JWKS_URI=http://localhost:5173/api/auth/jwks

# --- Access gate (@civitai/flipt, src/lib/server/access.ts) ---
# Moderators are always allowed; everyone else needs the `knights-of-new-order-app` flag on for them.
# Flags live in the `civitai-app` Flipt environment. Flag missing or Flipt down: moderators only.
FLIPT_URL=
FLIPT_FETCHER_SECRET=
# Dev-only: force the flag without touching shared Flipt state, e.g. `knights-of-new-order-app=on`.
# FLIPT_LOCAL_OVERRIDES=

# --- Database (the main Postgres; read via Kysely) ---
DATABASE_URL=postgres://user:password@localhost:5432/civitai
# Optional read replica for lag-tolerant reads (the play feed, the leaderboard). Unset: those read the primary too.
DATABASE_REPLICA_URL=

# --- Redis (system cluster; used only for session revocation checks) ---
REDIS_URL=redis://:password@localhost:6379
REDIS_SYS_URL=redis://:password@localhost:6380

# Main app base and shared secret used to write a settled rating back (/api/mod/image/kono-set-nsfw-level).
# WEBHOOK_TOKEN must equal the main app's; unset, a vote that would settle an image fails rather than skip.
CIVITAI_APP_URL=https://civitai.com
WEBHOOK_TOKEN=
# Base for links players follow (image pages, profiles, "Back to Civitai"). Defaults to https://civitai.red, the only
# domain that shows Knights; civitai.com sends R+ images to an "available on .red" page.
CIVITAI_SITE_URL=https://civitai.red
# Image CDN base (https://image.civitai.com/<account hash>) for the images players are shown.
IMAGE_LOCATION=
# Token a scheduler must present to the /api/jobs/* endpoints. Unset: they refuse.
JOBS_TOKEN=
# Key for the sealed ids of feed items.
FEED_TOKEN_SECRET=
# Game settings below: a value saved on the moderator app's Knights of New Order Config page overrides the variable (read
# at most every 30s); these are the fallback when nothing is saved there.
# Hidden check settings; unset values use the defaults in src/lib/server/hidden/config.ts.
KNIGHTS_HIDDEN_CHECK_RATE=
KNIGHTS_HIDDEN_CHECK_FAILURE_WINDOW_HOURS=
KNIGHTS_HIDDEN_CHECK_SEVERE_DISTANCE=
KNIGHTS_HIDDEN_CHECK_SETTLE_DELAY_MINUTES=
KNIGHTS_HIDDEN_CHECK_RETIRE_MIN_ANSWERS=
KNIGHTS_HIDDEN_CHECK_RETIRE_FAILURE_RATE=
# Share (0 to 1) of hidden checks drawn from probation references, which collect answers and grade nobody; default 0.
KNIGHTS_HIDDEN_CHECK_PROBATION_SHARE=

# Acolyte wrong-answer smites (and the career reset three of them start) are on by default; `off` stops new ones
# and holds the tick's reset of an Acolyte whose active smites are all wrong-answer smites.
# KNIGHTS_APPRENTICE_SMITES=off

# The moderator-ruling harvest runs when this is unset, `on`, `true` or `1`; `off`, `false`, `0` or any other value pauses it:
# no rulings are taken in and the cursor holds, but references whose ruling no longer stands are still retired. On
# resume, rulings older than the harvest's 14-day window are skipped, so a longer pause leaves those out for good.
# New rulings go to trials; set a share (0 to 1) to send that part of them to hidden checks instead. Both can be saved
# on the Config page ("Harvest"), which wins over these, read per harvest run.
# KNIGHTS_HARVEST=off
# KNIGHTS_HARVEST_HIDDEN_CHECK_SHARE=

# Yes/no questions: the chance a feed slot is one (0 switches them off; above 0.5 they come more often than ratings) and how many
# of one axis come in a row; unset values use the defaults in src/lib/server/yesno/config.ts.
KNIGHTS_YESNO_SHARE=
KNIGHTS_YESNO_STRETCH=
KNIGHTS_YESNO_MAX_AGE_DAYS=

# Paladin tag review (switched on only on the moderator app's Config page): a consensus is written back through the
# moderator app's /api/mod/image-tag-moderate. MODERATOR_APP_INTERNAL_URL is the in-cluster base (falls back to
# MODERATOR_APP_URL); KNIGHTS_TAG_REVIEW_TOKEN must equal the moderator app's and is accepted on that one path only.
# Unset, or not yet accepted there, consensus waits and is retried without spending attempts. Provisioning: ask an infra owner.
MODERATOR_APP_INTERNAL_URL=
MODERATOR_APP_URL=https://moderator.civitai.com
KNIGHTS_TAG_REVIEW_TOKEN=

# Converting earned gold to Yellow Buzz is on by default. Kill switch: set to true (also 1, yes or on, any case) to stop it;
# gold keeps accruing either way. A switch saved on the Config page wins, and a store outage keeps the last saved state.
# KNIGHTS_CONVERSION_DISABLED=true
# The gold shop (and its entry points) is on by default. Same kill-switch spelling; Buzz packs also obey KNIGHTS_CONVERSION_DISABLED.
# KNIGHTS_SHOP_DISABLED=true
# Live /play updates (settled items drop out, stats move) through the signal service. SIGNALS_ENDPOINT (server) sends
# signals and mints tokens; PUBLIC_SIGNALS_ENDPOINT (browser) is the hub. Either unset: /play works as before, without them.
SIGNALS_ENDPOINT=
PUBLIC_SIGNALS_ENDPOINT=
# KNIGHTS_SIGNALS_DISABLED=true
# Buzz service base URL for converting earned gold to Yellow Buzz. Unset: conversions stay pending.
BUZZ_ENDPOINT=
# Axiom logging; both must be set, neither alone does anything.
AXIOM_TOKEN=
AXIOM_ORG_ID=

# Notifications app base URL and shared secret.
NOTIFICATIONS_ENDPOINT=
NOTIFICATIONS_TOKEN=
