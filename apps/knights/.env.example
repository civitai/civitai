# Knights of New Order app — env template. Copy to `.env` and fill in. Placeholders only.
#
# A *.civitai.com SPOKE: it shares the hub's `.civitai.com` session cookie and has no login UI.

# --- Auth (spoke) ---
AUTH_JWT_ISSUER=https://auth.civitai.com
AUTH_JWKS_URI=https://auth.civitai.com/api/auth/jwks
AUTH_INTERNAL_TOKEN=
# Optional: route hub identity read-through to an internal service URL instead of the public issuer.
AUTH_HUB_INTERNAL_URL=

# Local dev against a LOCAL hub:
#   AUTH_JWT_ISSUER=http://localhost:5173
#   AUTH_JWKS_URI=http://localhost:5173/api/auth/jwks

# --- Access gate ---
# Moderators are always allowed. Add other testers here: comma-separated Civitai user ids.
# Empty means moderators only. Remove the gate (src/hooks.server.ts) when the app opens to everyone.
KNIGHTS_TESTER_USER_IDS=

# --- Database (the main Postgres; read via Kysely) ---
DATABASE_URL=postgres://user:password@localhost:5432/civitai

# --- Redis (system cluster; used only for session revocation checks) ---
REDIS_URL=redis://:password@localhost:6379
REDIS_SYS_URL=redis://:password@localhost:6380
