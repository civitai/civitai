# apps/assistant-runner — runtime env. Copy to `.env` for local runs; placeholder values only.

# --- server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- the runner's own Postgres database (never the main site database). DBOS creates its `dbos`
#     schema here on first start and keeps the runs, the queue and each run's event journal in it. ---
DATABASE_URL=postgres://runner:runner@localhost:5432/assistant_runner

# --- DBOS executor id: stable and distinct per replica (in Kubernetes, the StatefulSet pod name).
#     A restarted process recovers the runs its executor id held. Required when NODE_ENV=production. ---
RUNNER_EXECUTOR_ID=local

# --- limits ---
# Wall clock per run (ms) before it ends `ran_out`; default 2 h.
# RUN_WALL_CLOCK_MS=7200000
# How long a Stop waits for the run to end itself before it is cancelled outright (ms).
# RUN_STOP_GRACE_MS=5000
# Runs one process works on at once, across users (each user has at most one).
# RUN_WORKER_CONCURRENCY=50
