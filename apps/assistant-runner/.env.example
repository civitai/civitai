# apps/assistant-runner — runtime env. Copy to `.env` for local runs; placeholder values only.

# --- server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- the runner's own Postgres database (never the main site database). DBOS creates its `dbos`
#     schema here on first start and keeps the runs, the queue and each run's event journal in it. ---
DATABASE_URL=postgres://runner:runner@localhost:5432/assistant_runner

# --- DBOS executor id: stable and distinct per replica (in Kubernetes, the StatefulSet pod name).
#     A restarted process recovers the runs its executor id held. Required when NODE_ENV=production. ---
RUNNER_EXECUTOR_ID=local

# --- limits ---
# Wall clock per run (ms) before it ends `ran_out`; default 2 h.
# RUN_WALL_CLOCK_MS=7200000
# How long a Stop waits for the run to end itself before it is cancelled outright (ms).
# RUN_STOP_GRACE_MS=5000
# Runs one process works on at once, across users (each user has at most one).
# RUN_WORKER_CONCURRENCY=50
# Ended runs (journals and workflows) are deleted after this many days.
# RUN_RETENTION_DAYS=7
# On SIGTERM, how long runs in flight get to finish (ms); the rest resume on restart.
# RUN_SHUTDOWN_GRACE_MS=10000

# --- the run API's path, when the page reaches the runner on its own origin (health stays at /) ---
# RUNNER_BASE_PATH=/api/assistant-runner

# --- civitai: sign-in, run grants and token minting. Leave RUNNER_TOKEN_PUBLIC_KEY unset and the runner
#     refuses every run-API request (401); set it and the next three are required. Placeholders only. ---
# civitai's ES256 public key (SPKI PEM; one line with \n escapes is fine), the pair of civitai's
# ASSISTANT_RUNNER_SIGNING_KEY.
# RUNNER_TOKEN_PUBLIC_KEY=
# The runner's own secret for civitai's mint endpoint (civitai's ASSISTANT_RUNNER_SECRET).
# RUNNER_SECRET=
# CIVITAI_URL=https://civitai.example
# ORCHESTRATION_URL=https://orchestration.example
# The hosted sandbox service (civitai's APP_ASSISTANT_SANDBOX_URL): App Assistant's tools. Unset
# while civitai is configured, every start is refused.
# SANDBOX_URL=https://sandbox.example

# --- reply budgets, as App Assistant's page sets them ---
# RUN_MAX_STEPS=1000
# RUN_CONTEXT_BUDGET_TOKENS=64000
