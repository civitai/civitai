{
  "name": "referer-when-no-origin",
  "endpoint": "pulse",
  "request": {
    "method": "POST",
    "target": "/api/internal/pulse",
    "headers": {
      "host": "www.example.test",
      "referer": "https://www.example.test/models/123/some-slug",
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": "{\"type\":\"ImageView\",\"entityType\":\"Image\",\"entityId\":123,\"ads\":\"Served\",\"nsfw\":false,\"nsfwLevel\":1,\"browsingLevel\":31}"
  },
  "session": null,
  "trackerEnabled": true,
  "fallback": "",
  "expect": {
    "status": 200,
    "headers": {
      "vary": "Authorization",
      "access-control-allow-origin": "*",
      "access-control-allow-headers": "Authorization, Content-Type, *",
      "access-control-allow-methods": "POST",
      "cache-control": "public, s-maxage=300, stale-while-revalidate=150"
    },
    "body": "",
    "writes": [
      {
        "table": "views",
        "body": "{\"userId\":0,\"ip\":\"203.0.113.7\",\"userAgent\":\"unknown\",\"type\":\"ImageView\",\"entityType\":\"Image\",\"entityId\":123,\"ads\":\"Served\",\"nsfw\":false,\"nsfwLevel\":1,\"browsingLevel\":31}"
      }
    ]
  },
