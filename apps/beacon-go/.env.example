# beacon-go environment. Names match the main app's where the value is the same thing.
# Placeholders only — real values come from the deployment's secret.

# shadow (default): compute and compare against the Node sampler's samples, write nothing, no public
# listener. serve: answer the beacons and send their rows to the tracker.
BEACON_GO_MODE=shadow
BEACON_GO_ADDR=:8080
BEACON_GO_INTERNAL_ADDR=:9090
# serve mode only (both required there): the Node app, for every fallback; the ClickHouse tracker.
BEACON_GO_FALLBACK_URL=
# serve mode only: answer /api/track/batch here (exactly `true`). Off (default): every such request
# is proxied to the Node app unchanged. Its shadow compare endpoint runs either way and writes nothing.
BEACON_GO_TRACK_BATCH_SERVE=
# serve mode, with the route on: also answer batches with impression events (exactly `true`; needs
# CLICKHOUSE_HOST and CLICKHOUSE_USERNAME: the rows are inserted into ClickHouse directly, as Node
# does), and batches whose feed events are all of unsampled sessions (exactly `true`; needs FLIPT_URL
# for the sample rate). Both default off.
BEACON_GO_TRACK_BATCH_SERVE_IMPRESSIONS=
BEACON_GO_TRACK_BATCH_SERVE_FEED=
CLICKHOUSE_HOST=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
BEACON_GO_CLICKHOUSE_WORKERS=8
BEACON_GO_CLICKHOUSE_QUEUE=2000
# The feed events sample rate (`feed-events-sample-rate`), as the Node client reads Flipt. Optional in
# shadow mode: without it every batch with a feed event is counted as a fallback.
FLIPT_URL=
FLIPT_FETCHER_SECRET=
FLIPT_ENVIRONMENT=
CLICKHOUSE_TRACKER_URL=
BEACON_GO_TRACKER_WORKERS=16
BEACON_GO_TRACKER_QUEUE=10000
# outwardTrafficAllowed(): a loopback public origin writes nothing unless the opt-in is 'true'.
NEXT_PUBLIC_CIVITAI_LINK=
NEXT_PUBLIC_LOCAL_TRACKER_ENABLED=

# Cache cluster (session:data2) and system redis (revocation registry), both required.
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER=false
REDIS_SYS_URL=redis://localhost:6380
REDIS_SYS_READ_TIMEOUT_MS=1000
# REDIS_SYS_SENTINELS=localhost:26379
# REDIS_SYS_SENTINEL_NAME=mymaster
# REDIS_SYS_SENTINEL_PASSWORD=
# Outside production only: the namespace the Node app prefixes cache keys with.
CACHE_KEY_NAMESPACE=

# Session verification and rolling refresh (same values as the main app).
AUTH_JWT_ISSUER=http://localhost:5173
AUTH_JWKS_URI=http://localhost:5173/.well-known/jwks.json
AUTH_REQUIRE_IAT0=false
AUTH_SESSION_COOKIE_MODE=shared
AUTH_LEGACY_READ=true
# Per-site override of the two above, by registrable domain (e.g. civitai.red:host): a site listed host reads only
# the host-only cookie. Unset: every site follows them.
AUTH_SESSION_COOKIE_MODE_BY_SITE=
AUTH_SESSION_UPDATE_AGE=
CIVITAI_MODERATION_USER_ID=

BEACON_GO_SHADOW_WORKERS=8
BEACON_GO_COMPUTE_BUDGET_MS=2000
BEACON_GO_JWKS_REFRESH_MS=600000
BEACON_GO_JWKS_MAX_STALENESS_MS=1800000
