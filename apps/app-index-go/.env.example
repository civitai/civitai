# app-index-go reads only the process environment (no .env loading). Example values use reserved
# .invalid hosts; set real ones in the deployment.

# Required. The registry to subscribe to (its HTTP binding; /subscribe is appended).
APP_INDEX_REGISTRY_URL=https://registry.invalid
# Optional bearer token. Unset: an anonymous subscription, which the registry serves the audience
# anyone may read (SFW only).
APP_INDEX_REGISTRY_TOKEN=
# Optional: the index's own OAuth client. Set, every subscription carries a client-credentials
# token from the token endpoint, refetched before it expires and after an invalid_token (resuming
# from the stored cursor). ID, SECRET, TOKEN_URL and TOKEN_RESOURCE go together; never with
# APP_INDEX_REGISTRY_TOKEN. TOKEN_URL is https (http only to a cluster-local *.svc host). Set these
# last: after the hub and the registry origin accept the client (README, "Rollout order").
APP_INDEX_CLIENT_ID=
APP_INDEX_CLIENT_SECRET=
APP_INDEX_TOKEN_URL=
# The resource the token is for (required with a client).
APP_INDEX_TOKEN_RESOURCE=
# Optional, sent as the token request's `scope`.
APP_INDEX_TOKEN_SCOPE=
# Optional. The subscribed schema; default the app entity schema.
APP_INDEX_SCHEMA=urn:schema:apps.civitai.com:app@v1

# Required. The index's own Postgres database: the service creates its tables at startup. Never the
# site database: the index is a cache that can always be rebuilt from the registry. A direct
# (session) connection: the consumer lock is a session advisory lock, which a transaction-mode
# pooler would not hold.
APP_INDEX_DATABASE_URL=postgres://app_index:password@db.invalid:5432/app_index
APP_INDEX_DB_MAX_CONNS=4

# Optional, off by default: also follow the store listing schema into the listings read model
# (README, "Listings read model"). on/off. On needs APP_INDEX_DB_MAX_CONNS of at least 3.
APP_INDEX_LISTINGS=off
# With listings on: the key the web tier signs each listing API request's viewer with (at least 32
# bytes; README, "Listing API"). Unset or short, the listing routes answer 503. A secret.
APP_INDEX_VIEWER_KEY=

# HTTP: GET /search, /healthz, /readyz, /metrics, and with listings on GET /listings and /listings/{slug}.
APP_INDEX_ADDR=:8080
APP_INDEX_SEARCH_TIMEOUT_MS=2000

# There is no stream idle timeout: a live stream may be quiet for any length of time. Dead
# connections are detected by TCP keepalive and HTTP/2 pings (internal/registry).
# Reconnect backoff: exponential from BASE, capped at MAX, with jitter.
APP_INDEX_BACKOFF_BASE_MS=500
APP_INDEX_BACKOFF_MAX_MS=60000
