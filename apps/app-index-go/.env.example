# app-index-go reads only the process environment (no .env loading). Example values use reserved
# .invalid hosts; set real ones in the deployment.

# Required. The registry to subscribe to (its HTTP binding; /subscribe is appended).
APP_INDEX_REGISTRY_URL=https://registry.invalid
# Optional bearer token. Unset: an anonymous subscription, which the registry serves the audience
# anyone may read (SFW only).
APP_INDEX_REGISTRY_TOKEN=
# Optional. The subscribed schema; default the app entity schema.
APP_INDEX_SCHEMA=urn:schema:apps.civitai.com:app@v1

# Required. The index's own Postgres database: the service creates its tables at startup. Never the
# site database: the index is a cache that can always be rebuilt from the registry.
APP_INDEX_DATABASE_URL=postgres://app_index:password@db.invalid:5432/app_index
APP_INDEX_DB_MAX_CONNS=4

# HTTP: GET /search, /healthz, /readyz, /metrics.
APP_INDEX_ADDR=:8080
APP_INDEX_SEARCH_TIMEOUT_MS=2000

# A stream with no traffic (heartbeats count) for this long is treated as lost.
APP_INDEX_IDLE_TIMEOUT_MS=60000
# Reconnect backoff: exponential from BASE, capped at MAX, with jitter.
APP_INDEX_BACKOFF_BASE_MS=500
APP_INDEX_BACKOFF_MAX_MS=60000
