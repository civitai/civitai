      }
    },
    "body": "{\"hits\":[{\"id\":131,\"name\":\"Green\",\"images\":[{\"id\":1301,\"nsfwLevel\":4}]}],\"query\":\"x\",\"processingTimeMs\":0,\"limit\":20,\"offset\":0,\"estimatedTotalHits\":1}"
  }
}
