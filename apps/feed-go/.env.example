# feed-go environment. Names match the main app's where the value is the same thing.
# Placeholders only — real values come from the deployment's secret.

# Listeners: public tRPC path (served only when FEED_GO_FALLBACK_URL is set) and internal
# (/metrics, /healthz, /internal/shadow/...).
FEED_GO_ADDR=:8080
FEED_GO_INTERNAL_ADDR=:9090

# Read replica the Node path reads this procedure from (first non-empty wins).
DATAPACKET_DATABASE_RO_URL=
DATABASE_REPLICA_URL=postgres://user:password@localhost:5432/civitai
# Replica pool ceiling (default 8). A pool_max_conns in the URL wins.
FEED_GO_DB_MAX_CONNS=

# Cache cluster and system redis (both required). REDIS_CLUSTER=false for a single-node cache in dev.
REDIS_URL=redis://localhost:6379
REDIS_SYS_URL=redis://localhost:6380
REDIS_CLUSTER=false
REDIS_SYS_READ_TIMEOUT_MS=1000
# Optional: reach system redis through Sentinel (same vars as the Node app). When REDIS_SYS_SENTINELS
# is set, REDIS_SYS_SENTINEL_NAME is required and only the password in REDIS_SYS_URL is used.
# REDIS_SYS_SENTINELS=localhost:26379
# REDIS_SYS_SENTINEL_NAME=mymaster
# REDIS_SYS_SENTINEL_PASSWORD=
# Outside production only: the same namespace the Node app prefixes cache keys with.
CACHE_KEY_NAMESPACE=
IMAGE_QUERY_CACHING=false

# Session verification (same values as the main app).
AUTH_JWT_ISSUER=http://localhost:5173
AUTH_JWKS_URI=http://localhost:5173/.well-known/jwks.json
AUTH_REQUIRE_IAT0=false
AUTH_SESSION_COOKIE_MODE=shared
AUTH_LEGACY_READ=true
# Per-site override of the two above, by registrable domain (e.g. civitai.red:host): a site listed host reads only
# the host-only cookie. Unset: every site follows them.
AUTH_SESSION_COOKIE_MODE_BY_SITE=
# The shared moderation account's user id: never accepted as a session (unset = refused by username only).
CIVITAI_MODERATION_USER_ID=
# Resolve API keys (an Authorization header) as the main app does, from its principal cache (DESIGN.md
# §4.2; default off: every API credential is the bearer-token fallback). With it on, NEXTAUTH_SECRET (the
# key-hash salt) and ORCHESTRATOR_SERVICE_TOKEN must be the main app's values.
FEED_GO_BEARER_AUTH=false
NEXTAUTH_SECRET=
ORCHESTRATOR_SERVICE_TOKEN=
# Origin allow-list for the public route, besides the SERVER_DOMAIN_* hosts (same values as the main app).
TRPC_ORIGINS=
NEXTAUTH_URL=http://localhost:3000

# Domain colors and region restrictions (same values as the main app).
SERVER_DOMAIN_GREEN=
SERVER_DOMAIN_GREEN_ALIASES=
SERVER_DOMAIN_BLUE=localhost
SERVER_DOMAIN_BLUE_ALIASES=
SERVER_DOMAIN_RED=
SERVER_DOMAIN_RED_ALIASES=
REGION_RESTRICTION_CONFIG=

# Where everything this service does not answer goes (the Node app). Unset = shadow-only.
FEED_GO_FALLBACK_URL=

# Flag mirrors (see DESIGN.md "Flags"). Set each to the flag's real value.
# creator-promotions: the flag's audience (DESIGN.md "Flags"): false | mods-testers | everyone.
# true / unset = unknown (fail-safe): a page-1 version gallery that would carry a sponsored post falls back.
FEED_GO_CREATOR_PROMOTIONS=true
# gallery-lazy-post-images: on = posts completed, then sliced to 6 images + imageCount (ported).
FEED_GO_LAZY_POST_IMAGES=true
# image-index-feed: on = pages come from the feed service (FEED_SERVICE_URL), as the Node app reads
# them; off = the Postgres query. On without FEED_SERVICE_URL = every request falls back.
FEED_GO_IMAGE_INDEX_FEED=true
# The image feed service, the same value the Node app is given.
FEED_SERVICE_URL=
# The REST /api/v1/images shadow (DESIGN.md §13): the edge URL prefix the Node app publishes (same
# var; unset = that endpoint falls back).
NEXT_PUBLIC_IMAGE_LOCATION=
# frame-cache-negative: on = the image frame cache's notFound markers are live (read as "no frame",
# written on a miss); off (the default) = a marker is a miss and none is written, as Node does.
FEED_GO_FRAME_CACHE_NEGATIVE=false
# use-model-version-cache-for-images: mirrors that Flipt flag and must change with it. On =
# image.getInfinite's prioritizedUserIds requests on the Postgres path fall back
# (prioritized-version-cache: Node then reads imagesForModelVersionsCache); off (the default, the
# flag's production value) = the SQL branch is computed here.
FEED_GO_PRIORITIZED_VERSION_CACHE=false

# Cache misses (DESIGN.md §3.1). On (default): a miss on user cosmetics, image frames or event
# decorations is computed with the Node lookup's own query instead of falling back. (A metric-hash
# miss still falls back.)
FEED_GO_COMPUTE_MISSES=true
# The public images endpoint's image-resources misses, computed from the replica (DESIGN.md §3.1): its
# own switch, default off (those misses fall back); on, still only with FEED_GO_COMPUTE_MISSES and
# while Flipt's image-resource-use-write reads off (read at most 1 minute ago).
FEED_GO_COMPUTE_IMAGE_RESOURCES_MISS=false
# The caches whose computed misses are written back exactly as the Node lookup writes them (key,
# msgpackr bytes, expiry; SET NX), comma-separated: user-cosmetics, image-frames, event-decorations,
# tag-ids, model-frames, model-decorations, version-images, model-data, model-tags, official-models,
# metrics, creator-memberships (a plain SET, as Node's; DESIGN.md §3.1, §15.2.6), gallery-settings (the
# JSON entry getGallerySettingsByModelId writes, for a week; DESIGN.md §14.10). Empty (default) = this service never writes those keys; an unknown name
# (the old true/false included) fails startup. Listing image-frames,
# event-decorations, model-frames, model-decorations, version-images, model-data or gallery-settings
# needs DATABASE_URL, the primary those lookups then read, as Node's do.
FEED_GO_CACHE_WRITEBACK=
# DATABASE_URL=
# One `cache write` line per written key (cache, key, id, result; never the value), at most this many
# per minute per (cache, result); 0 = none.
FEED_GO_CACHE_WRITE_LOG_PER_MIN=0

# The REST /api/v1/models shadows (DESIGN.md §16) read FEED_GO_GENERATION_COVERAGE_NEXT (every
# model's supportsGeneration) and FEED_GO_BASE_MODEL_FEED_METRICS (the statement of a `baseModels`
# list request), the same mirrors as model.getAll below.
# The /api/v1/models/[id] origin response cache: on where the Node pods run with IS_DATAPACKET.
FEED_GO_MODEL_RESPONSE_CACHE=true

# Event decorations every viewer may see, comma-separated (empty = none).
FEED_GO_DECORATION_EVENTS=
# model.getAll's flags (DESIGN.md §15.3), each defaulting to its production value; only that state is
# ported, so any of them false makes every model.getAll sample fall back (`flag-off-state`):
# base-model-feed-metrics (a base-model filter reads the per-base-model metric tables),
FEED_GO_BASE_MODEL_FEED_METRICS=true
# the getAllModelImagesSlim feature (6 images per model by the coverage slice instead of 12),
FEED_GO_MODEL_IMAGES_SLIM=true
# generation-coverage-next and generation-loading-open-to-all (with both on every viewer is a member).
FEED_GO_GENERATION_COVERAGE_NEXT=true
FEED_GO_GENERATION_LOADING_OPEN_TO_ALL=true
FEED_GO_SHADOW_WORKERS=8
# Serve-side parity (DESIGN.md §7.2): the fraction of served tRPC answers replayed to the Node app
# (FEED_GO_FALLBACK_URL) after the response and compared, source="serve-parity". 0 (the default) = off.
FEED_GO_SERVE_PARITY_SAMPLE_RATE=0
# Bounds are constants (DESIGN.md §7.2): 4 replays in flight per pod, 10 s per replay.
# Eval capture (DESIGN.md §19.6): write sampled requests (shadow samples, serve-parity replays, and a
# FEED_GO_EVAL_CAPTURE_SERVE_RATE fraction of public requests) to the eval store. Off by default; on,
# the store's URL (its path names the database), user and password are required (an INSERT-only login).
FEED_GO_EVAL_CAPTURE=false
FEED_GO_EVAL_CLICKHOUSE_URL=
FEED_GO_EVAL_CLICKHOUSE_USER=
FEED_GO_EVAL_CLICKHOUSE_PASSWORD=
FEED_GO_EVAL_CAPTURE_SERVE_RATE=0
# The Node shadow sampler's rate, for a shadow capture's weight until samples carry their own (0: unknown).
FEED_GO_EVAL_CAPTURE_SHADOW_RATE=0
# Deadline of one computation (served or shadow), ms; past it the request falls back (`deadline`).
FEED_GO_REQUEST_BUDGET_MS=6000
# Public requests one pod computes at once (the Node app's heavy-image bulkhead); past it a request is
# proxied to the Node app (`bulkhead`). Unset, 0, negative or junk = the replica pool's max connections
# (FEED_GO_DB_MAX_CONNS or its default 8), never unlimited; a value above that is a startup warning.
# FEED_GO_MAX_IN_FLIGHT=8
# Lazy-post-images completion fetches one request runs at once. 4 suits shadow load; serving may want more.
FEED_GO_COMPLETION_CONCURRENCY=4
# How often the auth hub's JWKS is refetched, ms (a removed signing key stops verifying after this).
FEED_GO_JWKS_REFRESH_MS=600000
# How long the last good JWKS is kept while refreshes fail, ms (default 3 × the refresh interval);
# past it every session verifies as signed out until a fetch succeeds.
FEED_GO_JWKS_MAX_STALENESS_MS=1800000
# net/http/pprof under /debug/pprof/ on the INTERNAL listener only (default off).
FEED_GO_PPROF=false
# Compute model.getAll on the public route /api/trpc/model.getAll (default off: every request there is
# the model-getall-off fallback, proxied to the Node app unchanged).
FEED_GO_SERVE_MODEL_GETALL=false
# Compute a model.getAll request with `ids` / with `followed` (each default off: the input-ids /
# input-followed fallback, as before; DESIGN.md §15.2.4). They also decide whether the shadow computes
# those shapes.
FEED_GO_GETALL_SERVE_INPUT_IDS=false
FEED_GO_GETALL_SERVE_INPUT_FOLLOWED=false
# Compute a model.getAll request with Hide Paid on (default off: the input-hidePaid fallback; DESIGN.md
# §15.2.7). Also decides whether the shadow computes that shape.
FEED_GO_GETALL_SERVE_HIDE_PAID=false
# Compute a model.getAll page's user-cosmetics misses (the image pages' lookup; written back only as
# FEED_GO_CACHE_WRITEBACK lists user-cosmetics) instead of the user-cosmetics-miss fallback (default
# off; DESIGN.md §15.2.5). It also decides what the shadow computes.
FEED_GO_GETALL_SERVE_USER_COSMETICS_MISS=false
# Compute a model.getAll page's creator-membership misses (getValidCreatorMembershipMap's origin on the
# replica; written back only as FEED_GO_CACHE_WRITEBACK lists creator-memberships) instead of the
# membership-miss fallback (default off; DESIGN.md §15.2.6). It reads the tier from the product
# metadata key TIER_METADATA_KEY names (the app's own variable; unset: tier).
FEED_GO_GETALL_SERVE_MEMBERSHIP_MISS=false
# TIER_METADATA_KEY=tier
# Compute image.getInfinite on the public route /api/trpc/image.getInfinite (default off: every request
# there is the infinite-off fallback, proxied to the Node app unchanged).
FEED_GO_SERVE_INFINITE=false
# Compute an image.getInfinite request with postIds (several posts' media; default off: such a request
# is the input-postIds fallback, as before the port).
FEED_GO_INFINITE_SERVE_INPUT_POST_IDS=false
# Compute an image.getInfinite request for a collection's Random sort (default off: the input-sort
# fallback, as before the port). Nothing changes while FEED_GO_SERVE_INFINITE is off, except what the
# shadow computes.
FEED_GO_INFINITE_SERVE_SORT_RANDOM=false
# On image.getInfinite, answer a model gallery-settings key absent from the cache from the model's row
# (its minor / SFW-only hold, as the Node rebuild decides it; lag-aware; the whole entry written back
# only as FEED_GO_CACHE_WRITEBACK lists gallery-settings) instead of the gallery-settings-miss fallback
# (default off). Needs FEED_GO_COMPUTE_MISSES.
FEED_GO_INFINITE_SERVE_GALLERY_SETTINGS_MISS=false
# The same on GET /api/v1/images (default off). Needs gallery-settings in FEED_GO_CACHE_WRITEBACK
# (startup fails without it): Node's fallback writes the key, so serving without writing it would leave
# it cold for every other reader.
FEED_GO_V1_IMAGES_SERVE_GALLERY_SETTINGS_MISS=false
# Compute an image.getInfinite request with hubId (a user-composed hub, with its hubExcludedSources;
# default off: such a request is the input-hubId / input-hubExcludedSources fallback, as before the
# port). Reads the app's user-hubs flag per viewer from FLIPT_URL: without it every hubId request falls
# back (infinite-hub-flag-unknown).
FEED_GO_INFINITE_SERVE_INPUT_HUB_ID=false
# On an image.getInfinite collection page, answer an item whose note holds a judge's score with it
# (judgeScore, parsed from the note already read; default off: such a page is the collection-judge-score
# fallback, as before the port). A score the port does not rebuild exactly still falls back.
FEED_GO_INFINITE_SERVE_JUDGE_SCORE=false
# Compute an image.getInfinite request carrying a Hat Turf sort or Show filter where the app ignores
# them without reading anything: no session user, or a scoped feed (default off: the infinite-hat-turf
# fallback, as before the port). A signed-in viewer's main feed still falls back.
FEED_GO_INFINITE_SERVE_HAT_TURF_IGNORED=false
# Answer a public request from a region on REGION_BLOCK_CONFIG with the app's own 451 here, on every
# public route (default off: it is the region-blocked fallback, proxied to the Node app, which answers it).
FEED_GO_ANSWER_REGION_BLOCKED=false
# On image.getInfinite, answer a failed feed-service call (a transport error, the 5s timeout, a 5xx)
# with the app's own 503 here, for a signed-in viewer or a paged request: the ones the app answers
# with that 503 whatever feed-service-degrade says (default off: the feed-unavailable / feed-status
# fallback, proxied to the Node app, which calls the feed again). An anonymous first page always falls
# back: the app may answer it from its last-good page. On, the failed call is first made once more here
# (the second call the app would have made), when the request budget leaves a whole call's time for it.
# Nothing changes while FEED_GO_SERVE_INFINITE is off.
FEED_GO_INFINITE_ANSWER_FEED_UNAVAILABLE=false
# Compute an image.getInfinite request with publishedOnly (the own-content submit pickers; default off:
# such a request is the input-publishedOnly fallback, as before the port).
FEED_GO_INFINITE_SERVE_INPUT_PUBLISHED_ONLY=false
# The Node app that answers /api/v1 (a different upstream from FEED_GO_FALLBACK_URL's). Set, the public
# listener also routes GET /api/v1/models and /api/v1/models/{id} and proxies their fallbacks here;
# unset, those paths are not mounted (DESIGN.md §16.8).
FEED_GO_V1_FALLBACK_URL=
# Compute GET /api/v1/models and /api/v1/models/{id} on the public routes (default off: every request
# there is the v1-models-off fallback, proxied to FEED_GO_V1_FALLBACK_URL unchanged). On without
# FEED_GO_V1_FALLBACK_URL fails startup.
FEED_GO_SERVE_V1_MODELS=false
# The Node app that answers /api/v1/images. Set, the public listener also routes GET /api/v1/images
# (that path only) and proxies its fallbacks here; unset, the path is not mounted. Required for that
# route: FEED_GO_V1_FALLBACK_URL is never used for it (DESIGN.md §13.8).
FEED_GO_V1_IMAGES_FALLBACK_URL=
# Compute GET /api/v1/images on the public route (default off: every request there is the
# v1-images-off fallback, proxied unchanged). On without FEED_GO_V1_IMAGES_FALLBACK_URL fails startup.
FEED_GO_SERVE_V1_IMAGES=false
# Compute a GET /api/v1/images request with `imageId`, or with a `modelId` and no `modelVersionId`, on
# the legacy Postgres path as Node does (DESIGN.md §13.2.1; each default off: the v1-image-id /
# v1-model-only fallback, as before the port). Read by the shadow and the public route alike.
# Keep MODEL_ONLY off for now: its query reads the model's whole gallery, so most requested models run
# past FEED_GO_REQUEST_BUDGET_MS and are handed to Node, which runs it again (DESIGN.md §13.2.1, Cost).
FEED_GO_V1_IMAGES_SERVE_IMAGE_ID=false
FEED_GO_V1_IMAGES_SERVE_MODEL_ONLY=false
# Decide an API credential on GET /api/v1/models/{id} (shadow and public alike) as the Node route does
# (DESIGN.md §16.10; default off: every API credential there is the bearer-token fallback). The list
# keeps every API credential a fallback either way. Uses the FEED_GO_BEARER_AUTH key resolver: on
# without FEED_GO_BEARER_AUTH fails startup.
FEED_GO_V1_BEARER_AUTH=false
# Answer a GET /api/v1/models request with a text `query` on the public route, from the search index
# the Node app reads (DESIGN.md §16.11; default off: every one is the v1-models-query fallback). The
# search backend is the app's own SEARCH_HOST / SEARCH_API_KEY, each call bounded by
# MEILI_CALL_TIMEOUT_MS (default 2500, capped at 2500 here) and guarded by the app's own circuit
# settings (MEILI_CIRCUIT_TRIP_THRESHOLD / _WINDOW_SECONDS / _COOLDOWN_SECONDS, defaults 10 / 30 / 30)
# and a cap of 4 calls in flight; a rejected search is the v1-models-query fallback. With SEARCH_HOST
# set a shadow sample is computed whatever this says. On without SEARCH_HOST fails startup.
FEED_GO_V1_MODELS_SERVE_QUERY=false
SEARCH_HOST=
SEARCH_API_KEY=
# Serve a model-data cache miss on the public GET /api/v1/models route, computed with the cache's own
# lookup (DESIGN.md §16.7; default off: every one there is the v1-models-data-miss fallback). A
# shadow sample computes the miss whenever FEED_GO_COMPUTE_MISSES is on, so it is compared before
# this is turned on. Needs FEED_GO_COMPUTE_MISSES: on without it fails startup.
FEED_GO_V1_MODELS_SERVE_DATA_MISS=false

# Tracing (DESIGN.md §10.3), off by default. FEED_GO_OTEL_ENABLED is feed-go's own switch (the app's
# OTEL_ENABLED is not read); the rest are the Node app's variables, with its meaning: OTLP over
# HTTP/protobuf to <OTEL_EXPORTER_OTLP_ENDPOINT>/v1/traces, ParentBased trace-id-ratio sampling at
# OTEL_TRACES_SAMPLE_RATIO (0..1, default 0.1). Set OTEL_SERVICE_NAME=feed-go explicitly when enabling
# (the shared app config may carry Node's). Keep OTEL_TRACES_SAMPLE_RATIO at or above the Node app's
# (normally equal): the fallback proxy hands feed-go's sampling decision to Node, so Node's traces of
# proxied requests are capped at min(feed-go ratio, Node ratio).
FEED_GO_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=feed-go
# OTEL_TRACES_SAMPLE_RATIO=0.1
# One log line per fallback (reason, safe detail, trace id), at most this many per minute per
# (mode, endpoint, reason); 0 = none. Error lines are bounded the same way (default 60).
FEED_GO_FALLBACK_LOG_PER_MIN=0
FEED_GO_ERROR_LOG_PER_MIN=60
