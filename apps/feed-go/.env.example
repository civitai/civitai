# feed-go environment. Names match the main app's where the value is the same thing.
# Placeholders only — real values come from the deployment's secret.

# Listeners: public tRPC path (served only when FEED_GO_FALLBACK_URL is set) and internal
# (/metrics, /healthz, /internal/shadow/...).
FEED_GO_ADDR=:8080
FEED_GO_INTERNAL_ADDR=:9090

# Read replica the Node path reads this procedure from (first non-empty wins).
DATAPACKET_DATABASE_RO_URL=
DATABASE_REPLICA_URL=postgres://user:password@localhost:5432/civitai

# Cache cluster and system redis (both required). REDIS_CLUSTER=false for a single-node cache in dev.
REDIS_URL=redis://localhost:6379
REDIS_SYS_URL=redis://localhost:6380
REDIS_CLUSTER=false
REDIS_SYS_READ_TIMEOUT_MS=1000
# Outside production only: the same namespace the Node app prefixes cache keys with.
CACHE_KEY_NAMESPACE=
IMAGE_QUERY_CACHING=false

# Session verification (same values as the main app).
AUTH_JWT_ISSUER=http://localhost:5173
AUTH_JWKS_URI=http://localhost:5173/.well-known/jwks.json
AUTH_REQUIRE_IAT0=false
AUTH_SESSION_COOKIE_MODE=shared
AUTH_LEGACY_READ=true

# Domain colors and region restrictions (same values as the main app).
SERVER_DOMAIN_GREEN=
SERVER_DOMAIN_GREEN_ALIASES=
SERVER_DOMAIN_BLUE=localhost
SERVER_DOMAIN_BLUE_ALIASES=
SERVER_DOMAIN_RED=
SERVER_DOMAIN_RED_ALIASES=
REGION_RESTRICTION_CONFIG=

# Where everything this service does not answer goes (the Node app). Unset = shadow-only.
FEED_GO_FALLBACK_URL=

# Flag mirrors (see DESIGN.md "Flags"). They default to ON, which makes the affected requests fall
# back: set each to the flag's real value.
FEED_GO_CREATOR_PROMOTIONS=true
FEED_GO_LAZY_POST_IMAGES=true
# Event decorations every viewer may see, comma-separated (empty = none).
FEED_GO_DECORATION_EVENTS=
FEED_GO_SHADOW_WORKERS=8
