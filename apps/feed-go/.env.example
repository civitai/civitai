# feed-go environment. Names match the main app's where the value is the same thing.
# Placeholders only — real values come from the deployment's secret.

# Listeners: public tRPC path (served only when FEED_GO_FALLBACK_URL is set) and internal
# (/metrics, /healthz, /internal/shadow/...).
FEED_GO_ADDR=:8080
FEED_GO_INTERNAL_ADDR=:9090

# Read replica the Node path reads this procedure from (first non-empty wins).
DATAPACKET_DATABASE_RO_URL=
DATABASE_REPLICA_URL=postgres://user:password@localhost:5432/civitai
# Replica pool ceiling (default 8). A pool_max_conns in the URL wins.
FEED_GO_DB_MAX_CONNS=

# Cache cluster and system redis (both required). REDIS_CLUSTER=false for a single-node cache in dev.
REDIS_URL=redis://localhost:6379
REDIS_SYS_URL=redis://localhost:6380
REDIS_CLUSTER=false
REDIS_SYS_READ_TIMEOUT_MS=1000
# Optional: reach system redis through Sentinel (same vars as the Node app). When REDIS_SYS_SENTINELS
# is set, REDIS_SYS_SENTINEL_NAME is required and only the password in REDIS_SYS_URL is used.
# REDIS_SYS_SENTINELS=localhost:26379
# REDIS_SYS_SENTINEL_NAME=mymaster
# REDIS_SYS_SENTINEL_PASSWORD=
# Outside production only: the same namespace the Node app prefixes cache keys with.
CACHE_KEY_NAMESPACE=
IMAGE_QUERY_CACHING=false

# Session verification (same values as the main app).
AUTH_JWT_ISSUER=http://localhost:5173
AUTH_JWKS_URI=http://localhost:5173/.well-known/jwks.json
AUTH_REQUIRE_IAT0=false
AUTH_SESSION_COOKIE_MODE=shared
AUTH_LEGACY_READ=true
# Per-site override of the two above, by registrable domain (e.g. civitai.red:host): a site listed host reads only
# the host-only cookie. Unset: every site follows them.
AUTH_SESSION_COOKIE_MODE_BY_SITE=
# The shared moderation account's user id: never accepted as a session (unset = refused by username only).
CIVITAI_MODERATION_USER_ID=
# Origin allow-list for the public route, besides the SERVER_DOMAIN_* hosts (same values as the main app).
TRPC_ORIGINS=
NEXTAUTH_URL=http://localhost:3000

# Domain colors and region restrictions (same values as the main app).
SERVER_DOMAIN_GREEN=
SERVER_DOMAIN_GREEN_ALIASES=
SERVER_DOMAIN_BLUE=localhost
SERVER_DOMAIN_BLUE_ALIASES=
SERVER_DOMAIN_RED=
SERVER_DOMAIN_RED_ALIASES=
REGION_RESTRICTION_CONFIG=

# Where everything this service does not answer goes (the Node app). Unset = shadow-only.
FEED_GO_FALLBACK_URL=

# Flag mirrors (see DESIGN.md "Flags"). Set each to the flag's real value.
# creator-promotions: the flag's audience (DESIGN.md "Flags"): false | mods-testers | everyone.
# true / unset = unknown (fail-safe): a page-1 version gallery that would carry a sponsored post falls back.
FEED_GO_CREATOR_PROMOTIONS=true
# gallery-lazy-post-images: on = posts completed, then sliced to 6 images + imageCount (ported).
FEED_GO_LAZY_POST_IMAGES=true
# image-index-feed: on = pages come from the feed service (FEED_SERVICE_URL), as the Node app reads
# them; off = the Postgres query. On without FEED_SERVICE_URL = every request falls back.
FEED_GO_IMAGE_INDEX_FEED=true
# The image feed service, the same value the Node app is given.
FEED_SERVICE_URL=
# The REST /api/v1/images shadow (DESIGN.md §13): the edge URL prefix the Node app publishes (same
# var; unset = that endpoint falls back).
NEXT_PUBLIC_IMAGE_LOCATION=
# frame-cache-negative: on = the image frame cache's notFound markers are live (read as "no frame",
# written on a miss); off (the default) = a marker is a miss and none is written, as Node does.
FEED_GO_FRAME_CACHE_NEGATIVE=false
# use-model-version-cache-for-images: mirrors that Flipt flag and must change with it. On =
# image.getInfinite's prioritizedUserIds requests on the Postgres path fall back
# (prioritized-version-cache: Node then reads imagesForModelVersionsCache); off (the default, the
# flag's production value) = the SQL branch is computed here.
FEED_GO_PRIORITIZED_VERSION_CACHE=false

# Cache misses (DESIGN.md §3.1). On (default): a miss on user cosmetics, image frames or event
# decorations is computed with the Node lookup's own query instead of falling back. (A metric-hash
# miss still falls back.)
FEED_GO_COMPUTE_MISSES=true
# The caches whose computed misses are written back exactly as the Node lookup writes them (key,
# msgpackr bytes, expiry; SET NX), comma-separated: user-cosmetics, image-frames, event-decorations,
# tag-ids, model-frames, model-decorations, version-images, model-data, model-tags, official-models,
# metrics (DESIGN.md §3.1). Empty (default) = this service never writes those keys; an unknown name
# (the old true/false included) fails startup. Listing image-frames,
# event-decorations, model-frames, model-decorations, version-images or model-data needs DATABASE_URL,
# the primary those lookups then read, as Node's do.
FEED_GO_CACHE_WRITEBACK=
# DATABASE_URL=
# One `cache write` line per written key (cache, key, id, result; never the value), at most this many
# per minute per (cache, result); 0 = none.
FEED_GO_CACHE_WRITE_LOG_PER_MIN=0

# The REST /api/v1/models shadows (DESIGN.md §16) read FEED_GO_GENERATION_COVERAGE_NEXT (every
# model's supportsGeneration) and FEED_GO_BASE_MODEL_FEED_METRICS (the statement of a `baseModels`
# list request), the same mirrors as model.getAll below.
# The /api/v1/models/[id] origin response cache: on where the Node pods run with IS_DATAPACKET.
FEED_GO_MODEL_RESPONSE_CACHE=true

# Event decorations every viewer may see, comma-separated (empty = none).
FEED_GO_DECORATION_EVENTS=
# model.getAll's flags (DESIGN.md §15.3), each defaulting to its production value; only that state is
# ported, so any of them false makes every model.getAll sample fall back (`flag-off-state`):
# base-model-feed-metrics (a base-model filter reads the per-base-model metric tables),
FEED_GO_BASE_MODEL_FEED_METRICS=true
# the getAllModelImagesSlim feature (6 images per model by the coverage slice instead of 12),
FEED_GO_MODEL_IMAGES_SLIM=true
# generation-coverage-next and generation-loading-open-to-all (with both on every viewer is a member).
FEED_GO_GENERATION_COVERAGE_NEXT=true
FEED_GO_GENERATION_LOADING_OPEN_TO_ALL=true
FEED_GO_SHADOW_WORKERS=8
# Deadline of one computation (served or shadow), ms; past it the request falls back (`deadline`).
FEED_GO_REQUEST_BUDGET_MS=6000
# Public requests one pod computes at once (the Node app's heavy-image bulkhead); past it a request is
# proxied to the Node app (`bulkhead`). Unset, 0, negative or junk = the replica pool's max connections
# (FEED_GO_DB_MAX_CONNS or its default 8), never unlimited; a value above that is a startup warning.
# FEED_GO_MAX_IN_FLIGHT=8
# Lazy-post-images completion fetches one request runs at once. 4 suits shadow load; serving may want more.
FEED_GO_COMPLETION_CONCURRENCY=4
# How often the auth hub's JWKS is refetched, ms (a removed signing key stops verifying after this).
FEED_GO_JWKS_REFRESH_MS=600000
# How long the last good JWKS is kept while refreshes fail, ms (default 3 × the refresh interval);
# past it every session verifies as signed out until a fetch succeeds.
FEED_GO_JWKS_MAX_STALENESS_MS=1800000
# net/http/pprof under /debug/pprof/ on the INTERNAL listener only (default off).
FEED_GO_PPROF=false
# Compute model.getAll on the public route /api/trpc/model.getAll (default off: every request there is
# the model-getall-off fallback, proxied to the Node app unchanged).
FEED_GO_SERVE_MODEL_GETALL=false

# Tracing (DESIGN.md §10.3), off by default. FEED_GO_OTEL_ENABLED is feed-go's own switch (the app's
# OTEL_ENABLED is not read); the rest are the Node app's variables, with its meaning: OTLP over
# HTTP/protobuf to <OTEL_EXPORTER_OTLP_ENDPOINT>/v1/traces, ParentBased trace-id-ratio sampling at
# OTEL_TRACES_SAMPLE_RATIO (0..1, default 0.1). Set OTEL_SERVICE_NAME=feed-go explicitly when enabling
# (the shared app config may carry Node's). Keep OTEL_TRACES_SAMPLE_RATIO at or above the Node app's
# (normally equal): the fallback proxy hands feed-go's sampling decision to Node, so Node's traces of
# proxied requests are capped at min(feed-go ratio, Node ratio).
FEED_GO_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=feed-go
# OTEL_TRACES_SAMPLE_RATIO=0.1
# One log line per fallback (reason, safe detail, trace id), at most this many per minute per
# (mode, endpoint, reason); 0 = none. Error lines are bounded the same way (default 60).
FEED_GO_FALLBACK_LOG_PER_MIN=0
FEED_GO_ERROR_LOG_PER_MIN=60
