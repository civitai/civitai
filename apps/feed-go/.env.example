# feed-go environment. Names match the main app's where the value is the same thing.
# Placeholders only — real values come from the deployment's secret.

# Listeners: public tRPC path (served only when FEED_GO_FALLBACK_URL is set) and internal
# (/metrics, /healthz, /internal/shadow/...).
FEED_GO_ADDR=:8080
FEED_GO_INTERNAL_ADDR=:9090

# Read replica the Node path reads this procedure from (first non-empty wins).
DATAPACKET_DATABASE_RO_URL=
DATABASE_REPLICA_URL=postgres://user:password@localhost:5432/civitai
# Replica pool ceiling (default 8). A pool_max_conns in the URL wins.
FEED_GO_DB_MAX_CONNS=

# Cache cluster and system redis (both required). REDIS_CLUSTER=false for a single-node cache in dev.
REDIS_URL=redis://localhost:6379
REDIS_SYS_URL=redis://localhost:6380
REDIS_CLUSTER=false
REDIS_SYS_READ_TIMEOUT_MS=1000
# Optional: reach system redis through Sentinel (same vars as the Node app). When REDIS_SYS_SENTINELS
# is set, REDIS_SYS_SENTINEL_NAME is required and only the password in REDIS_SYS_URL is used.
# REDIS_SYS_SENTINELS=localhost:26379
# REDIS_SYS_SENTINEL_NAME=mymaster
# REDIS_SYS_SENTINEL_PASSWORD=
# Outside production only: the same namespace the Node app prefixes cache keys with.
CACHE_KEY_NAMESPACE=
IMAGE_QUERY_CACHING=false

# Session verification (same values as the main app).
AUTH_JWT_ISSUER=http://localhost:5173
AUTH_JWKS_URI=http://localhost:5173/.well-known/jwks.json
AUTH_REQUIRE_IAT0=false
AUTH_SESSION_COOKIE_MODE=shared
AUTH_LEGACY_READ=true
# The shared moderation account's user id: never accepted as a session (unset = refused by username only).
CIVITAI_MODERATION_USER_ID=
# Origin allow-list for the public route, besides the SERVER_DOMAIN_* hosts (same values as the main app).
TRPC_ORIGINS=
NEXTAUTH_URL=http://localhost:3000

# Domain colors and region restrictions (same values as the main app).
SERVER_DOMAIN_GREEN=
SERVER_DOMAIN_GREEN_ALIASES=
SERVER_DOMAIN_BLUE=localhost
SERVER_DOMAIN_BLUE_ALIASES=
SERVER_DOMAIN_RED=
SERVER_DOMAIN_RED_ALIASES=
REGION_RESTRICTION_CONFIG=

# Where everything this service does not answer goes (the Node app). Unset = shadow-only.
FEED_GO_FALLBACK_URL=

# Flag mirrors (see DESIGN.md "Flags"). Set each to the flag's real value.
# creator-promotions: the flag's audience (DESIGN.md "Flags"): false | mods-testers | everyone.
# true / unset = unknown (fail-safe): a page-1 version gallery that would carry a sponsored post falls back.
FEED_GO_CREATOR_PROMOTIONS=true
# gallery-lazy-post-images: on = posts completed, then sliced to 6 images + imageCount (ported).
FEED_GO_LAZY_POST_IMAGES=true
# image-index-feed: on = pages come from the feed service (FEED_SERVICE_URL), as the Node app reads
# them; off = the Postgres query. On without FEED_SERVICE_URL = every request falls back.
FEED_GO_IMAGE_INDEX_FEED=true
# The image feed service, the same value the Node app is given.
FEED_SERVICE_URL=
# The REST /api/v1/images shadow (DESIGN.md §13): the edge URL prefix the Node app publishes (same
# var; unset = that endpoint falls back).
NEXT_PUBLIC_IMAGE_LOCATION=
# Event decorations every viewer may see, comma-separated (empty = none).
FEED_GO_DECORATION_EVENTS=
FEED_GO_SHADOW_WORKERS=8
# Deadline of one computation (served or shadow), ms; past it the request falls back (`deadline`).
FEED_GO_REQUEST_BUDGET_MS=6000
# Lazy-post-images completion fetches one request runs at once. 4 suits shadow load; serving may want more.
FEED_GO_COMPLETION_CONCURRENCY=4
# How often the auth hub's JWKS is refetched, ms (a removed signing key stops verifying after this).
FEED_GO_JWKS_REFRESH_MS=600000
# How long the last good JWKS is kept while refreshes fail, ms (default 3 × the refresh interval);
# past it every session verifies as signed out until a fetch succeeds.
FEED_GO_JWKS_MAX_STALENESS_MS=1800000
# net/http/pprof under /debug/pprof/ on the INTERNAL listener only (default off).
FEED_GO_PPROF=false
