# app-data-go reads only the process environment (no .env loading). Example values use reserved
# .invalid hosts; set real ones in the deployment. Both URLs carry users' bearer tokens: https, or
# plain http only to a cluster-local *.svc host.

# Required. The site whose document store answers the REST fallback (/api/v1/blocks/storage/… is
# appended).
APP_DATA_REST_URL=https://site.invalid
# Optional. The registry ADAPTER the per-user streams are opened on, directly (its HTTP binding;
# /subscribe is appended). Unset: the registry path is OFF, every read is the REST read and no token
# is exchanged. Set, the relay client below is required.
APP_DATA_REGISTRY_URL=

# The relay client: this service's own confidential hub client, which exchanges each user's token
# for one toward the adapter (RFC 8693). Required with APP_DATA_REGISTRY_URL, refused without it.
APP_DATA_HUB_TOKEN_URL=
APP_DATA_CLIENT_ID=
# The secret from a mounted file (preferred), or from the environment; never both.
APP_DATA_CLIENT_SECRET_FILE=
APP_DATA_CLIENT_SECRET=
# The adapter's resource identifier, exchanged for.
APP_DATA_EXCHANGE_RESOURCE=
# Exchange App Block tokens too, at the hub's block exchange (true/1 on; unset, false or 0 off).
# Default off: a block token then reads REST only and is never sent to the hub. Needs the registry
# path, and the hub must list this client as a block-exchange caller (DESIGN.md, "Block tokens").
APP_DATA_BLOCK_EXCHANGE=
# The site's block-token JWKS (https://<site>/api/v1/block-tokens/jwks). Required with the block
# exchange, and with the writes: each block token's signature and claims are checked against it
# before the hub is asked, or a write is forwarded.
APP_DATA_BLOCK_JWKS_URL=

# The write routes and info (WRITES-DESIGN.md), forwarded signed to the site's internal storage route
# (true/1 on; unset, false or 0 off). Default off: every write route answers 404. On needs the signing
# key and APP_DATA_BLOCK_JWKS_URL; with it off, the settings below are ignored (the start logs a warning).
APP_DATA_WRITES=
# The HMAC key shared with the site (at least 32 bytes).
APP_DATA_WRITES_SIGNING_KEY=
# The site the writes go to (/api/internal/blocks/storage/… is appended). Default: APP_DATA_REST_URL.
APP_DATA_WRITES_SITE_URL=
# One forward's timeout (2000 to 20000; default 10000). Must exceed the site's permission-hook client
# timeout (at most 950 ms) plus the rest of the store's chain; past it a write answers 504, outcome
# unknown. The 20000 cap keeps a drain (the timeout + 2 s, after a 5 s preStop) inside a 30 s
# termination grace period.
APP_DATA_WRITES_TIMEOUT_MS=
# The registry adapter's poll interval, in seconds (1 to 600; default 60). Keep it at or above the
# adapter's own REGISTRY_ADAPTER_POLL_SECONDS: an acknowledged write is shown over its token's stream
# for this plus 30 s, so a value below the adapter's lets an overlay expire before the stream can
# show the write. A read's floor (minSeq) reopens its stream at most once per this interval.
APP_DATA_WRITES_ADAPTER_POLL_SECONDS=

# With APP_DATA_WRITES on and the registry path set, shared collections and signed-out viewers are
# read from the adapter's level streams (under this client's own service token, client credentials,
# scope AppsRead) and per-viewer streams (WRITES-DESIGN.md), never from REST; and every read is a
# cut-over app's: never read from REST. The level streams' bounds: LEVEL_MAX_RECORDS at least the
# adapter's REGISTRY_ADAPTER_LEVEL_STREAM_MAX_RECORDS (above 2000).
APP_DATA_LEVEL_MAX_STREAMS=10
APP_DATA_LEVEL_MAX_RECORDS=3000
APP_DATA_LEVEL_MAX_BYTES=8388608
# The per-viewer streams' bounds: VIEWER_MAX_RECORDS at the adapter's
# REGISTRY_ADAPTER_VIEWER_STREAM_MAX_RECORDS (default 20000).
APP_DATA_VIEWER_MAX_STREAMS=40
APP_DATA_VIEWER_MAX_RECORDS=20000
APP_DATA_VIEWER_MAX_BYTES=4194304

# HTTP: GET /v1/apps/{slug}/collections/{collection}/records, /healthz, /readyz, /metrics (and, with
# APP_DATA_WRITES on, the write routes, GET /v1/apps/{slug}/info, the keyed get
# GET /v1/apps/{slug}/collections/{collection}/records/{key}, and a read's ?minSeq= floor).
APP_DATA_ADDR=:8080

# Stream caps (DESIGN.md, "Stream count against the adapter's caps").
APP_DATA_MAX_STREAMS=100
APP_DATA_MAX_STREAMS_PER_TOKEN=4
APP_DATA_STREAM_IDLE_TTL_MS=300000
# At most 900000: an exchanged token lives at most 15 minutes, and a stream also closes 30 s before
# its own token expires.
APP_DATA_STREAM_MAX_AGE_MS=840000
# How long a read waits for a new stream's Live; less than the request deadline.
APP_DATA_LIVE_WAIT_MS=1500
APP_DATA_REQUEST_DEADLINE_MS=4000
# One private stream's cache bounds, and (with the writes on) its overlays' byte bound.
APP_DATA_MAX_RECORDS_PER_STREAM=1000
APP_DATA_MAX_BYTES_PER_STREAM=2097152
APP_DATA_MAX_OVERLAY_BYTES_PER_STREAM=131072
# Every stream together, private, level and per-viewer: adapter subscriptions held at once, and the
# bytes their caches may reach (each stream reserves its own bound; config.DefaultCacheBudgetBytes
# has the arithmetic against the deployment's memory).
APP_DATA_MAX_SUBSCRIPTIONS=100
APP_DATA_CACHE_BUDGET_BYTES=234881024
# Concurrent REST reads; over it a read answers 503.
APP_DATA_REST_MAX_INFLIGHT=64
