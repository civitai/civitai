# storage-hook-runner configuration. Copy to .env for local runs.

# Shared HMAC secret: civitai signs requests with it, the runner signs responses with it.
# At least 32 characters. Generate with: openssl rand -hex 32
STORAGE_HOOK_RUNNER_SECRET=

# Request port (POST /v1/check, /healthz, /readyz) and the separate metrics port (/metrics).
PORT=8080
METRICS_PORT=9091

# Worker threads (one evaluation each at a time). Defaults to the container's cgroup v2 CPU
# quota (rounded up), else availableParallelism().
# POOL_SIZE=2

# Calls allowed to wait for a free worker before the runner answers 503.
# MAX_QUEUE=64

# Calls one app may have queued plus in flight. Defaults to a quarter of MAX_QUEUE, rounded up.
# MAX_PER_APP=16
