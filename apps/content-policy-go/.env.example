# content-policy-go reads only the process environment (no .env loading). Example values use reserved
# .invalid hosts; set real ones in the deployment. Names match the main app's where the value is the
# same thing, so a deployment can be fed the sources the site reads.

# HTTP: POST /v1/decide, GET /healthz, /readyz.
CONTENT_POLICY_ADDR=:8080
# GET /metrics only, on its own listener so a network policy can admit Prometheus there without
# admitting it to /v1/decide. Must differ from CONTENT_POLICY_ADDR.
CONTENT_POLICY_METRICS_ADDR=:9090

# The read target for user settings (first non-empty wins, feed-go's order). The service runs one
# SELECT by primary key on "User"; a read replica is enough.
DATAPACKET_DATABASE_RO_URL=
DATABASE_REPLICA_URL=postgres://user:password@db.invalid:5432/civitai
DATABASE_URL=
# Pool ceiling (default 4). A pool_max_conns in the URL wins.
CONTENT_POLICY_DB_MAX_CONNS=

# One user read, after which the answer is the SFW fallback (reason=error, 503).
CONTENT_POLICY_LOOKUP_TIMEOUT_MS=250
# How long a user's settings are kept in process (0: not kept), and how many users at most.
CONTENT_POLICY_CACHE_TTL_MS=30000
CONTENT_POLICY_CACHE_MAX_ENTRIES=100000

# The site's region lists, same values as the site. Unset: the site's defaults (policydata.json).
REGION_RESTRICTION_CONFIG=
REGION_BLOCK_CONFIG=
