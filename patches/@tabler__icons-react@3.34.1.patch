 const createReactComponent = (type, iconName, iconNamePascal, iconNode) => {
+  // civitai patch (patches/@tabler__icons-react@3.34.1.patch): the icon's own <path>/<circle>
+  // elements depend only on iconNode, so in production build them once (on first render) and
+  // reuse them on every render after, instead of allocating a fresh element per shape per render.
+  // React elements are immutable, so reusing them renders the same markup. Development builds
+  // keep building them per render: a dev element records the fiber that created it (_owner), and
+  // a module-cached one would pin the first icon's fiber for the life of the page.
+  let iconChildren;
+  const buildIconChildren = () => iconNode.map(([tag, attrs]) => react.createElement(tag, attrs));
   const Component = react.forwardRef(
     ({ color = "currentColor", size = 24, stroke = 2, title, className, children, ...rest }, ref) => react.createElement(
       "svg",
@@ -51,7 +59,7 @@ const createReactComponent = (type, iconName, iconNamePascal, iconNode) => {
       },
       [
         title && react.createElement("title", { key: "svg-title" }, title),
-        ...iconNode.map(([tag, attrs]) => react.createElement(tag, attrs)),
+        ...process.env.NODE_ENV === "production" ? iconChildren || (iconChildren = buildIconChildren()) : buildIconChildren(),
         ...Array.isArray(children) ? children : [children]
       ]
     )
