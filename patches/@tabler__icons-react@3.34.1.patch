index a2a2ddb619e9eba980521eea12d83cf0902e12f8..c2a4b93698c991bdefc141db02a9429761efee4b 100644
--- a/dist/cjs/tabler-icons-react.cjs
+++ b/dist/cjs/tabler-icons-react.cjs
@@ -32,6 +32,14 @@ var defaultAttributes = {
