{
  "manifest_version": 3,
  "name": "Civitai Markdown Importer",
  "version": "1.0.0",
  "description": "Load a .md file straight into the Civitai article editor.",
  "permissions": ["activeTab", "clipboardWrite"],
  "host_permissions": ["https://civitai.com/*", "https://civitai.red/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import Markdown"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/articles/create*",
        "https://civitai.com/articles/*/edit*",
        "https://civitai.red/articles/create*",
        "https://civitai.red/articles/*/edit*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
