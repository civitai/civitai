                  "fill": "$io-gold",
                  "content": "SMITES AND HEARTS",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "FJEZ3",
                  "name": "Judging in bad faith ear",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Judging in bad faith earns smites. Each lowers the weight of your votes, and right judgments wear them away. You have 3 hearts; lose them all and your career resets.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
