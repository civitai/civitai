                  "id": "FJEZ3",
                  "name": "Judging in bad faith ear",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Judging in bad faith earns smites. Each lowers the weight of your votes, and right judgments wear them away. You have 3 hearts; lose them all and your career resets.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
