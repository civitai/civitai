                      "name": "Fact 3",
                      "fill": "$io-parchment",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Example: 400 right of 500 judged is 400 × 100 × 80% = 32,000 fervor.",
                      "lineHeight": 1.45,
                      "fontFamily": "$io-font-ui",
                      "fontSize": 12,
                      "fontWeight": "normal"
