            {
              "type": "frame",
              "id": "K458l",
              "name": "Acolyte Trials",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "rMLsJ",
                  "name": "ACOLYTE TRIALS",
                  "fill": "$io-gold",
                  "content": "ACOLYTE TRIALS",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "GpojY",
                  "name": "Everyone begins as an Ac",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Everyone begins as an Acolyte. A Trial is a run of up to 12 images with known answers. Score 75% or more on the fresh ones to become a Knight; fall short and you may try again after 24 hours.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "lq1L6",
              "name": "Voting and verdicts",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "xOdPP",
                  "name": "VOTING AND VERDICTS",
                  "fill": "$io-gold",
                  "content": "VOTING AND VERDICTS",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "BtKzy",
                  "name": "Each image asks one ques",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Each image asks one question, usually how it should be rated. Judges answer independently, and you never see anyone else's answer. When enough judges agree the image is rated that way; a split goes up to higher ranks, and finally to a moderator.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Sro7c",
              "name": "XP and ranks",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "NFO7j",
                  "name": "XP AND RANKS",
                  "fill": "$io-gold",
                  "content": "XP AND RANKS",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "d8SkWz",
                  "name": "A judgment gives 10 XP a",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A judgment gives 10 XP at once and 90 more when graded correct. Accuracy is the share of your last 500 graded judgments that were right. Below the bar of your rank, vote weight and gold are halved, but you are never demoted.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wvL1E",
              "name": "The daily Watch and streaks",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "wxBQB",
                  "name": "THE DAILY WATCH AND STRE",
                  "fill": "$io-gold",
                  "content": "THE DAILY WATCH AND STREAKS",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "jf2YG",
                  "name": "Judge the day's images t",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Judge the day's images to complete the Watch and earn a streak bonus. Miss a day and the streak resets; one free weekly shield covers exactly one missed day. Each rank has a daily gold cap; past it, judgments still earn XP.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "suvT4",
              "name": "Gold",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "jcq4R",
                  "name": "GOLD",
                  "fill": "$io-gold",
                  "content": "GOLD",
                  "fontFamily": "$io-font-display",
                  "fontSize": 14,
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "f3OZrj",
                  "name": "A judgment starts at 100",
                  "fill": "$io-parchment",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A judgment starts at 100 gold for a Knight, more at higher ranks, and is pending until the image is decided. A correct verdict makes it earned; a wrong or inconclusive one drops it.",
                  "lineHeight": 1.4,
                  "fontFamily": "$io-font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
