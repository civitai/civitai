                      "fill": "$io-parchment-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Counts judgments you cast in the last 7 days once their verdict is in. Older ones fall away, so fervor fades when you rest.",
                      "lineHeight": 1.45,
                      "fontFamily": "$io-font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Os70Q",
                      "name": "Fact 2",
                      "fill": "$io-parchment-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Accuracy is the share you judged rightly. It never counts below 10%, and inconclusive images don't count either way.",
                      "lineHeight": 1.45,
                      "fontFamily": "$io-font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "J19Py",
                      "name": "Fact 3",
                      "fill": "$io-parchment",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Example: 400 right of 500 judged is 400 × 100 × 80% = 32,000 fervor.",
                      "lineHeight": 1.45,
                      "fontFamily": "$io-font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
