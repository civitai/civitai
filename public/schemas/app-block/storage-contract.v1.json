{
  "$comment": "App Blocks document store — declarative contract for /api/v1/blocks/storage. Every case runs against fresh apps and an empty store. A step is one request; `expect.body` is a SUBSET match (extra fields allowed) where an array must match element-wise at the same length, and these strings are matchers: \"$string\", \"$number\", \"$iso\" (an ISO-8601 timestamp), \"$present\", \"$absent\" (the key must not exist), \"$null\". {\"$capture\": \"name\"} stores the value it matches; \"${name}\" in a later path, query or body string is replaced by it, and \"${i}\" by the repeat index; in a request body \"$repeat:<c>:<n>\" is the character <c> repeated n times. A runner must also check that no response carries a numeric user id. The host runs this suite against the real handlers (src/server/services/apps/__tests__/doc-store-api.contract.test.ts); an SDK fake can run it against itself.",
  "version": 1,
  "conventions": {
    "blockedText": "contract-blocked-term",
    "blockedLink": "https://contract-blocked.example/x",
    "scannerDown": "contract-scanner-down",
    "note": "A runner's moderation scanner rejects any string leaf, object key or document key containing blockedText (category blocked) or blockedLink (category link), and fails (an outage) on scannerDown.",
    "rateLimits": "Each fixed-window limit is per (app, viewer): reads 300/min (an anonymous reader per client IP), private document writes and every delete 120/min, marks and counters 30/min, reports 20/day. A report is a mark, so it also spends one from the marks-and-counters bucket. Shared document creates and updates spend the shared write budget, per (app, viewer), three token buckets refilling continuously: burst 10 (one token back every 6 minutes), daily 50 (one back every 28.8 minutes), and rejections 10 (one back every 30 minutes). A write takes one burst and one daily token and is refused while either, or the rejection bucket, is empty; a write that does not land gives both back, and if the refusal was about the request rather than an outage it also spends one rejection token.",
    "keys": "A document key is 1-128 characters of [A-Za-z0-9._:-] and must not consist only of dots: URL clients rewrite `.` and `..` path segments, so such a key could never be addressed."
  },
  "storage": {
    "collections": {
      "prefs": {
        "visibility": "private"
      },
      "posts": {
        "visibility": "shared",
        "write": "own",
        "marks": ["vote"],
        "counters": ["views"],
        "indexes": {
          "status": "string"
        },
        "showAuthor": true
      },
      "notes": {
        "visibility": "shared",
        "write": "own"
      },
      "plays": {
        "visibility": "shared",
        "write": "none",
        "counters": ["plays"]
      }
    }
  },
  "apps": ["A", "B"],
  "viewers": {
    "v1": {
      "username": "contract_v1",
      "trusted": true
    },
    "v2": {
      "username": "contract_v2",
      "trusted": true
    },
    "v3": {
      "username": "contract_v3",
      "trusted": true
    },
    "newbie": {
      "username": "contract_newbie",
      "trusted": false,
      "untrustedReason": "account_too_new"
    }
  },
  "limits": {
    "viewerDocs": 12
  },
  "defaultScopes": ["apps:storage", "apps:storage:publish"],
  "stepFields": {
    "as": "\"<viewer>@<app>\", \"anon@<app>\", or \"none\" (no token at all)",
    "token": "optional: \"dev\" for a dev token as the bearer dev-token route mints one for an approved app (namespace dev:<uid>)",
    "scopes": "optional: the token's scopes, default defaultScopes",
    "consentMarker": "optional, per case: \"unavailable\", or the list of scopes the viewer revoked",
    "appStatus": "optional, per case: the backing app's status, default approved",
    "storage": "optional, per case: \"disabled\" for a store with no database configured",
    "repeat": "optional: send the step this many times, each expected to match"
  },
  "cases": [
    {
      "name": "info: declared collections, limits, usage",
      "steps": [
        {
          "as": "v1@A",
          "method": "GET",
          "path": "",
          "expect": {
            "status": 200,
            "body": {
              "collections": {
                "prefs": {
                  "visibility": "private",
                  "write": "$absent"
                },
                "posts": {
                  "visibility": "shared",
                  "write": "own",
                  "marks": ["vote"],
                  "counters": ["views"],
                  "indexes": {
                    "status": "string"
                  },
                  "showAuthor": true
                },
                "plays": {
                  "write": "none"
                }
              },
              "limits": {
                "docBytes": 65536,
                "viewerDocs": 12,
                "getManyMax": 100
              },
              "usage": {
                "app": {
                  "bytes": 0,
                  "docs": 0
                },
                "viewer": {
                  "bytes": 0,
                  "docs": 0
                }
              }
            }
          }
        },
        {
          "as": "anon@A",
          "method": "GET",
          "path": "",
          "expect": {
            "status": 401,
            "code": "sign_in_required"
          }
        }
      ]
    },
    {
      "name": "private document: put, get, conditional put, conditional delete",
      "steps": [
        {
          "as": "v1@A",
          "method": "PUT",
          "path": "/prefs/theme",
          "body": {
            "data": {
              "mode": "dark"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "key": "theme",
              "data": {
                "mode": "dark"
              },
              "version": 1,
              "createdAt": "$iso",
              "updatedAt": "$iso",
              "author": {
                "kind": "user",
                "isViewer": true,
                "username": "$absent"
              },
              "counters": {},
              "marks": {},
              "viewer": {
                "marks": []
              }
            }
          }
        },
        {
          "as": "v1@A",
          "method": "GET",
          "path": "/prefs/theme",
          "expect": {
            "status": 200,
            "body": {
              "data": {
                "mode": "dark"
              },
              "version": 1
            }
          }
        },
        {
          "as": "v1@A",
          "method": "PUT",
          "path": "/prefs/theme",
          "body": {
            "data": {
              "mode": "light"
            },
            "ifVersion": 1
          },
          "expect": {
            "status": 200,
            "body": {
              "version": 2
            }
          }
        },
        {
          "as": "v1@A",
          "method": "PUT",
          "path": "/prefs/theme",
          "body": {
            "data": {
              "mode": "stale"
            },
            "ifVersion": 1
          },
          "expect": {
            "status": 409,
            "code": "version_conflict",
            "body": {
              "message": "$string",
              "error": "$string",
              "details": {
                "currentVersion": 2
              }
            }
          }
        },
        {
          "as": "v1@A",
          "method": "PUT",
          "path": "/prefs/fresh",
          "body": {
            "data": {},
            "ifVersion": 3
          },
          "expect": {
            "status": 409,
            "code": "version_conflict",
            "body": {
              "details": {
                "currentVersion": 0
              }
            }
          }
        },
        {
          "as": "v1@A",
          "method": "DELETE",
          "path": "/prefs/theme",
          "query": {
            "ifVersion": "1"
          },
          "expect": {
            "status": 409,
            "code": "version_conflict"
          }
        },
        {
          "as": "v1@A",
          "method": "DELETE",
          "path": "/prefs/theme",
          "query": {
            "ifVersion": "2"
          },
          "expect": {
            "status": 200,
            "body": {
              "deleted": true
            }
          }
        },
        {
          "as": "v1@A",
          "method": "DELETE",
          "path": "/prefs/theme",
          "expect": {
            "status": 200,
            "body": {
              "deleted": false
            }
          }
        },
        {
          "as": "v1@A",
          "method": "GET",
          "path": "/prefs/theme",
          "expect": {
            "status": 404,
            "code": "not_found"
          }
        }
      ]
    },
    {
      "name": "create with a server key, then batch get with a miss",
      "steps": [
        {
          "as": "v1@A",
          "method": "POST",
          "path": "/prefs",
          "body": {
            "data": {
              "n": 1
            }
          },
          "expect": {
            "status": 201,
            "body": {
              "key": {
                "$capture": "k"
              },
              "version": 1
            }
          }
        },
        {
          "as": "v1@A",
          "method": "POST",
          "path": "/_get/prefs",
          "body": {
            "keys": ["${k}", "missing"]
          },
          "expect": {
            "status": 200,
            "body": {
              "items": [
                {
                  "key": "${k}",
                  "data": {
                    "n": 1
                  }
                },
                "$null"
              ]
            }
          }
        },
        {
          "as": "v1@A",
          "method": "GET",
          "path": "/_get/prefs",
          "expect": {
            "status": 405,
            "code": "method_not_allowed"
          }
        }
      ]
    },
