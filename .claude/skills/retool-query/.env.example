# Retool Database Query Runner Configuration
#
# This skill queries the moderator PostgreSQL database (the former Retool database) for moderation
# notes, strikes and other Retool-era data.
# Read-only by default. Use --writable flag for write operations.

# Moderator database connection (RETOOL_DATABASE_URL is the retired name and still works)
MODERATOR_DATABASE_URL=postgresql://user:password@host:5432/moderator?sslmode=require
