# Redis Inspection Tool Configuration
#
# This skill inspects Redis cache keys, values, and TTLs.
# Supports both the cache and the system store (--sys flag).

# Cache URL (default)
# Cached and recomputable data
REDIS_URL=redis://user:password@localhost:6379

# System store URL (for --sys flag): durable state, not a cache.
# Separate stores in every deployed environment, so use two distinct URLs here too.
REDIS_SYS_URL=redis://user:password@localhost:6380
