# The moderator database — the `retool_db` resource in the app exports, consolidated 2026-08-21 into
# the same instance as the xguard-lab tables.
#
# Holds the moderation data that never lived in Civitai's database: user notes, strikes, timed mutes,
# ModerationImageHelp, ReToolActions/RetoolNotes. The moderator app reads and writes it at runtime
# through `getModeratorDb()`; this skill is for scoping and schema questions outside the app.
#
# Copy to `.env` (gitignored) and fill in. `RETOOL_DATABASE_URL` is the retired name and still works.
MODERATOR_DATABASE_URL=postgresql://user:password@host:5432/moderator?sslmode=require
