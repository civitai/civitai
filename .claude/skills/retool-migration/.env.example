# Retool's own Postgres — the `retool_db` resource in the app exports.
#
# Holds the moderation data that never lived in Civitai's database and is the blocker for several
# migration slices: user notes, strikes, timed mutes, ModerationImageHelp, ReToolActions/RetoolNotes.
# Read it to scope the data migration; the moderator app must NOT read it at runtime.
#
# Copy to `.env` (gitignored) and fill in. Ask the moderation team or check the Retool resource config.
RETOOL_DATABASE_URL=postgresql://user:password@host:5432/retool?sslmode=require
