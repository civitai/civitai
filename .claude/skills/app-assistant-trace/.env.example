# Civitai API configuration for the app-assistant-trace skill.
# Copy to .env in this directory (it is gitignored). The key must be a FULL-ACCESS personal API key
# of a MODERATOR account (https://civitai.com/user/account, API Keys); any other key is refused.

CIVITAI_API_KEY=your-api-key-here

# API base URL (defaults to https://civitai.com). Use http://localhost:3000 for local development.
CIVITAI_API_URL=https://civitai.com
